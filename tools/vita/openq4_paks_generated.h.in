// data validation path will be re-enabled once the full client is running.
#define OPENQ4_PAK0_MD5 "00000000000000000000000000000000"
#define OPENQ4_PAK0_SIZE_BYTES 0
#define OPENQ4_PAK0_FILE_COUNT 0
#define OPENQ4_PAK1_MD5 "00000000000000000000000000000000"
#define OPENQ4_PAK1_SIZE_BYTES 0
#define OPENQ4_PAK1_FILE_COUNT 0

#endif
